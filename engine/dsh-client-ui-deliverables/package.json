{
  "name": "@apmixbot/dsh-client-ui-deliverables",
  "description": "Changed-files card with per-file comparison tabs, delivery cards, and clickable final-response file references for Web",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@apmixbot/dsh-api-remotes",
        "@apmixbot/dsh-client-connection",
        "@apmixbot/dsh-client-locale",
        "@apmixbot/dsh-client-ui-chat",
        "@apmixbot/dsh-client-ui-conversation",
        "@apmixbot/dsh-client-ui-renderer",
        "@apmixbot/dsh-client-ui-sidebar-right",
        "@apmixbot/dsh-client-ui-tool",
        "@apmixbot/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@apmixbot/dsh-typert-protocol": "0.2.1-rc.2"
  }
}

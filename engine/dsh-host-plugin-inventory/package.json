{
  "name": "@apmixbot/dsh-host-plugin-inventory",
  "description": "Read-only Remote projection of current Cordis Loader plugin state",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@apmixbot/cordis-plugin-loader": "1.0.6",
    "@apmixbot/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@apmixbot/dsh-brand": "0.2.1-rc.2",
    "@apmixbot/dsh-typert-protocol": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5"
  },
  "peerDependenciesMeta": {
    "@apmixbot/dsh-agent-preset-registry": {
      "optional": true
    }
  }
}

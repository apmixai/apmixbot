{
  "name": "@apmixbot/dsh-client-ui-primitives",
  "description": "Pure React atoms for the dsh web UI: controls, icons, markdown, and JSON inspectors (zero cordis)",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/**/*.css",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5"
  }
}

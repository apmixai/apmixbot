{
  "name": "@apmixbot/dsh-bash-sandbox",
  "description": "Sandbox-consuming implementation of the ApmixBot bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/dsh-shell": "0.2.1-rc.2",
    "@apmixbot/dsh-bash-local": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox-policy": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5"
  }
}

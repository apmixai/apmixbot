{
  "name": "@apmixbot/dsh-subprocess",
  "description": "Subprocess seam (ctx.subprocess) for the ApmixBot — managed process groups, bounded spill-backed output, and escalated kills behind one abstract service",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./control": {
      "types": "./lib/types/control.d.ts",
      "default": "./lib/control.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/control.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-http-proxy": "0.2.1-rc.2"
  }
}

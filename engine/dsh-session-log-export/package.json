{
  "name": "@apmixbot/dsh-session-log-export",
  "description": "Web Session-log export command and shared download dialog",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@apmixbot/dsh-session-format": "0.2.1-rc.2",
    "@apmixbot/schemastery": "3.18.5",
    "fflate": "^0.8.2",
    "@apmixbot/dsh-brand": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-session": "0.2.1-rc.2",
    "@apmixbot/dsh-session-persistence": "0.2.1-rc.2"
  },
  "dsh": {
    "client": {
      "inject": [
        "@apmixbot/dsh-client-locale",
        "@apmixbot/dsh-client-ui-commands",
        "@apmixbot/dsh-client-ui-conversation",
        "@apmixbot/dsh-client-ui-renderer",
        "@apmixbot/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  }
}

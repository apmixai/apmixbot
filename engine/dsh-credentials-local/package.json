{
  "name": "@apmixbot/dsh-credentials-local",
  "description": "File-backed credentials provider ($DSH_HOME/.env under the live process environment) for the ApmixBot",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/dsh-atomic-write": "0.2.1-rc.2",
    "@apmixbot/dsh-credentials": "0.2.1-rc.2",
    "@apmixbot/dsh-launch-environment": "0.2.1-rc.2",
    "@apmixbot/dsh-home-paths": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "@apmixbot/schemastery": "3.18.5",
    "yaml": "^2.9.0"
  }
}

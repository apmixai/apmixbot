{
  "name": "@apmixbot/dsh-client-file-upload",
  "description": "Agent-scoped browser file upload, streaming intake, and staged receipt service",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@apmixbot/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "zod": "4.4.3",
    "@apmixbot/dsh-typert-protocol": "0.2.1-rc.2",
    "@apmixbot/dsh-brand": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5"
  }
}

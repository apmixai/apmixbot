{
  "name": "@apmixbot/dsh-session-format-catalog",
  "description": "Build-static first-party Session format codec and migration catalog",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./message-projections": {
      "types": "./lib/types/message-projections.d.ts",
      "default": "./lib/types/message-projections.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@apmixbot/dsh-session-format": "0.2.1-rc.2",
    "@apmixbot/dsh-session-format-v0-to-v1": "0.2.1-rc.2",
    "@apmixbot/dsh-session-format-v1-to-v2": "0.2.1-rc.2",
    "@apmixbot/dsh-session-format-v2-to-v3": "0.2.1-rc.2",
    "@apmixbot/dsh-session-format-v3-to-v4": "0.2.1-rc.2",
    "@apmixbot/dsh-compaction-image-offload": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-session": "0.2.1-rc.2"
  }
}

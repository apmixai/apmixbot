{
  "name": "@apmixbot/dsh-client-ui-settings-general",
  "description": "Settings ownerless-copy and product onboarding plugin: the General section, shell trigger/header chrome content, settings dictionaries, and the versioned welcome notice",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@apmixbot/dsh-client-ui-settings",
        "@apmixbot/dsh-client-locale",
        "@apmixbot/dsh-client-connection",
        "@apmixbot/dsh-api-remotes",
        "@apmixbot/dsh-client-ui-sidebar",
        "@apmixbot/dsh-client-shortcuts",
        "@apmixbot/dsh-client-modules",
        "@apmixbot/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@apmixbot/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}

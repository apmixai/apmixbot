{
  "name": "@apmixbot/dsh-working-directory",
  "description": "Session working directories with durable changes and model context",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-agent": "0.2.1-rc.2",
    "@apmixbot/dsh-fs": "0.2.1-rc.2",
    "@apmixbot/dsh-llm": "0.2.1-rc.2",
    "@apmixbot/dsh-session": "0.2.1-rc.2",
    "@apmixbot/dsh-session-projection": "0.2.1-rc.2",
    "@apmixbot/dsh-system-prompt": "0.2.1-rc.2"
  },
  "dependencies": {
    "@apmixbot/schemastery": "3.18.5",
    "zod": "^4.4.3"
  }
}

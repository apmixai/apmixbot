{
  "name": "@apmixbot/dsh-experimental-tool-worktree",
  "description": "Model tool that creates and enters a new Git worktree",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-tools": "0.2.1-rc.2",
    "@apmixbot/dsh-experimental-worktree": "0.2.1-rc.2"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@apmixbot/dsh-experimental-worktree": "0.2.1-rc.2"
  }
}

{
  "name": "@apmixbot/dsh-workflow-ptc",
  "description": "Workflow orchestration in the shared sandboxed Node PTC runtime",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",

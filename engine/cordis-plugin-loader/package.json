{
  "name": "@apmixbot/cordis-plugin-loader",
  "description": "Plugin loader for cordis",
  "version": "1.0.6",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "node-addon-require-builtin": "^0.1.9"
  },
  "peerDependenciesMeta": {
    "node-addon-require-builtin": {
      "optional": true
    }
  },
  "dependencies": {
    "@apmixbot/cosmokit": "1.8.6",
    "@apmixbot/schemastery": "3.18.5"
  }
}

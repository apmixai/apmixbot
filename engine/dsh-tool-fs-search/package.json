{
  "name": "@apmixbot/dsh-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@apmixbot/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@apmixbot/dsh-llm": "0.2.1-rc.2",
    "@apmixbot/dsh-output-retention": "0.2.1-rc.2",
    "@apmixbot/dsh-session": "0.2.1-rc.2",
    "@apmixbot/dsh-spill": "0.2.1-rc.2",
    "@apmixbot/dsh-subprocess": "0.2.1-rc.2",
    "@apmixbot/dsh-system-prompt": "0.2.1-rc.2",
    "@apmixbot/dsh-timeout": "0.2.1-rc.2",
    "@apmixbot/dsh-tools": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-working-directory": "0.2.1-rc.2"
  }
}

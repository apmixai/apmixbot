{
  "name": "@apmixbot/dsh-subagent",
  "description": "Abstract subagent seam (ctx.subagents): named-provider registry for delegating to child agents",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./internal": {
      "types": "./lib/types/internal.d.ts",
      "default": "./lib/types/internal.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@apmixbot/dsh-brand": "0.2.1-rc.2",
    "@apmixbot/dsh-chunked-list": "0.2.1-rc.2",
    "@apmixbot/dsh-util-values": "0.2.1-rc.2",
    "@apmixbot/schemastery": "3.18.5",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-agent": "0.2.1-rc.2",
    "@apmixbot/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@apmixbot/dsh-attachment": "0.2.1-rc.2",
    "@apmixbot/dsh-llm": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox-policy": "0.2.1-rc.2",
    "@apmixbot/dsh-scope": "0.2.1-rc.2",
    "@apmixbot/dsh-session": "0.2.1-rc.2",
    "@apmixbot/dsh-session-persistence": "0.2.1-rc.2",
    "@apmixbot/dsh-session-projection": "0.2.1-rc.2",
    "@apmixbot/dsh-session-query": "0.2.1-rc.2",
    "@apmixbot/dsh-system-prompt": "0.2.1-rc.2",
    "@apmixbot/dsh-tools": "0.2.1-rc.2",
    "@apmixbot/dsh-typert-protocol": "0.2.1-rc.2",
    "@apmixbot/dsh-user-approval": "0.2.1-rc.2",
    "@apmixbot/dsh-util-time": "0.2.1-rc.2",
    "@apmixbot/dsh-permission-presets": "0.2.1-rc.2",
    "@apmixbot/dsh-workspace": "0.2.1-rc.2",
    "@apmixbot/dsh-working-directory": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@apmixbot/dsh-agent-preset-registry": {
      "optional": true
    },
    "@apmixbot/dsh-permission-presets": {
      "optional": true
    },
    "@apmixbot/dsh-sandbox": {
      "optional": true
    },
    "@apmixbot/dsh-sandbox-policy": {
      "optional": true
    },
    "@apmixbot/dsh-session-persistence": {
      "optional": true
    },
    "@apmixbot/dsh-session-projection": {
      "optional": true
    },
    "@apmixbot/dsh-session-query": {
      "optional": true
    },
    "@apmixbot/dsh-workspace": {
      "optional": true
    },
    "@apmixbot/dsh-user-approval": {
      "optional": true
    }
  }
}

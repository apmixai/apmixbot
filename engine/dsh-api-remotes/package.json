{
  "name": "@apmixbot/dsh-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@apmixbot/dsh-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@apmixbot/dsh-deque": "0.2.1-rc.2",
    "@apmixbot/dsh-util-values": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-scope": "0.2.1-rc.2"
  }
}

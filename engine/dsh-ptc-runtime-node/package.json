{
  "name": "@apmixbot/dsh-ptc-runtime-node",
  "description": "Node PTC execution with per-call sandboxed processes or in-memory REPL state",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/process.js",
    "lib/persistent-process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-ptc-runtime": "0.2.1-rc.2",
    "@apmixbot/dsh-session": "0.2.1-rc.2",
    "@apmixbot/dsh-timeout": "0.2.1-rc.2",
    "@apmixbot/dsh-fs": "0.2.1-rc.2",
    "@apmixbot/dsh-subprocess": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox-policy": "0.2.1-rc.2"
  },
  "dependencies": {
    "@apmixbot/dsh-util-values": "0.2.1-rc.2",
    "@apmixbot/schemastery": "3.18.5"
  }
}

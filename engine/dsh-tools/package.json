{
  "name": "@apmixbot/dsh-tools",
  "description": "Tool registry and execution pipeline for the ApmixBot",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-agent": "0.2.1-rc.2",
    "@apmixbot/dsh-ptc-runtime": "0.2.1-rc.2",
    "@apmixbot/dsh-llm": "0.2.1-rc.2",
    "@apmixbot/dsh-scope": "0.2.1-rc.2",
    "@apmixbot/dsh-session": "0.2.1-rc.2",
    "@apmixbot/dsh-system-prompt": "0.2.1-rc.2",
    "@apmixbot/dsh-user-approval": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox-policy": "0.2.1-rc.2",
    "@apmixbot/dsh-working-directory": "0.2.1-rc.2"
  },
  "dependencies": {
    "@apmixbot/dsh-brand": "0.2.1-rc.2",
    "@apmixbot/dsh-util-values": "0.2.1-rc.2",
    "@apmixbot/schemastery": "3.18.5"
  }
}

{
  "name": "@apmixbot/dsh-client-shortcuts",
  "description": "Application keyboard command registry and physical-key routing",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@apmixbot/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/protocol.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@apmixbot/dsh-util-crypto": "0.2.1-rc.2",
    "@apmixbot/dsh-util-values": "0.2.1-rc.2",
    "@apmixbot/schemastery": "3.18.5"
  }
}

{
  "name": "@apmixbot/dsh-compaction-image-offload",
  "description": "Durable image offload for image-capable routes: replace over-budget request images with placeholders and retry",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./projection": {
      "types": "./lib/types/projection.d.ts",
      "default": "./lib/types/projection.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-agent": "0.2.1-rc.2",
    "@apmixbot/dsh-compaction": "0.2.1-rc.2",
    "@apmixbot/dsh-llm": "0.2.1-rc.2",
    "@apmixbot/dsh-session": "0.2.1-rc.2"
  },
  "dependencies": {
    "@apmixbot/dsh-util-values": "0.2.1-rc.2"
  }
}

{
  "name": "@apmixbot/dsh-plugin-market",
  "description": "Configured plugin market indexes for the Web Discover page and the plugin_market agent tool",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@apmixbot/dsh-app-boot": "0.2.1-rc.2",
    "@apmixbot/dsh-package-manifest": "0.2.1-rc.2",
    "@apmixbot/dsh-plugin-market-index": "0.2.1-rc.2",
    "@apmixbot/dsh-timeout": "0.2.1-rc.2",
    "@apmixbot/dsh-util-values": "0.2.1-rc.2",
    "@apmixbot/schemastery": "3.18.5",
    "minisearch": "^7.2.0",
    "semver": "^7.8.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/cordis-plugin-loader": "1.0.6",
    "@apmixbot/dsh-plugin-manager": "0.2.1-rc.2",
    "@apmixbot/dsh-settings": "0.2.1-rc.2",
    "@apmixbot/dsh-tools": "0.2.1-rc.2",
    "@apmixbot/dsh-typert-protocol": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@apmixbot/dsh-settings": {
      "optional": true
    }
  }
}

{
  "name": "@apmixbot/dsh-client-ui-attachment",
  "description": "Dynamic attachment presentation plugin for conversation input, message-image, and trajectory image slots",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@apmixbot/dsh-client-locale",
        "@apmixbot/dsh-client-ui-chat",
        "@apmixbot/dsh-client-ui-conversation",
        "@apmixbot/dsh-client-ui-renderer",
        "@apmixbot/dsh-client-ui-trajectory",
        "@apmixbot/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5"
  }
}

{
  "name": "@apmixbot/dsh-api-terminal-controller",
  "description": "Session-owned interactive terminals with shell discovery, screen recovery and typed Remote control",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@apmixbot/dsh-api-gateway"
      ],
      "external": [
        "@apmixbot/dsh-api-gateway/client"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@apmixbot/dsh-deque": "0.2.1-rc.2",
    "@apmixbot/dsh-lazy-require": "0.2.1-rc.2",
    "@apmixbot/dsh-typert-protocol": "0.2.1-rc.2",
    "@apmixbot/dsh-util-values": "0.2.1-rc.2",
    "@apmixbot/schemastery": "3.18.5",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@apmixbot/dsh-subprocess": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}

{
  "name": "@apmixbot/dsh-agent-preset",
  "description": "Declare an Agent capability composition in Cordis YAML",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "skills",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/cordis-plugin-loader": "1.0.6",
    "@apmixbot/dsh-agent-preset-registry": "0.2.1-rc.2"
  },
  "dependencies": {
    "@apmixbot/schemastery": "3.18.5"
  }
}

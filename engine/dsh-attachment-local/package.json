{
  "name": "@apmixbot/dsh-attachment-local",
  "description": "Private content-addressed DSH_HOME attachment storage",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/dsh-attachment": "0.2.1-rc.2",
    "@apmixbot/dsh-home-paths": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5"
  },
  "dependencies": {
    "@apmixbot/dsh-lazy-require": "0.2.1-rc.2",
    "@apmixbot/schemastery": "3.18.5",
    "sharp": "0.35.5"
  }
}

{
  "name": "@apmixbot/dsh-client-ui-theme",
  "description": "Theme plugin: Host bootstrap for the pre-plugin palette; DOM-free ThemeRuntime for light/dark/system state; --dsw-* token styles and Appearance settings row",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./brand-font.css": "./lib/styles/brand-font.css",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@apmixbot/dsh-client-connection",
        "@apmixbot/dsh-client-locale",
        "@apmixbot/dsh-client-shortcuts",
        "@apmixbot/dsh-client-ui-renderer",
        "@apmixbot/dsh-client-ui-settings",
        "@apmixbot/dsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/styles",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@apmixbot/schemastery": "3.18.5"
  }
}

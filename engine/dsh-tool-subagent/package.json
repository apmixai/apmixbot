{
  "name": "@apmixbot/dsh-tool-subagent",
  "description": "Model-facing subagent delegation tool over the ctx.subagents seam",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./model-selection-settings": {
      "types": "./lib/types/model-selection-settings.d.ts",
      "default": "./lib/model-selection-settings.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./model-selection-settings/locale/*.json": "./locale/model-selection-settings/*.json"
  },
  "files": [
    "locale/*.json",
    "locale/model-selection-settings/*.json",
    "lib/index.js",
    "lib/model-selection-settings.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/dsh-agent": "0.2.1-rc.2",
    "@apmixbot/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@apmixbot/dsh-llm": "0.2.1-rc.2",
    "@apmixbot/dsh-session": "0.2.1-rc.2",
    "@apmixbot/dsh-session-projection": "0.2.1-rc.2",
    "@apmixbot/dsh-scope": "0.2.1-rc.2",
    "@apmixbot/dsh-subagent": "0.2.1-rc.2",
    "@apmixbot/dsh-system-prompt": "0.2.1-rc.2",
    "@apmixbot/dsh-tools": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5"
  },
  "peerDependenciesMeta": {
    "@apmixbot/dsh-agent-preset-registry": {
      "optional": true
    }
  },
  "dependencies": {
    "@apmixbot/schemastery": "3.18.5",
    "zod": "4.4.3"
  }
}

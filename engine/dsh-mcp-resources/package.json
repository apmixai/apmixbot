{
  "name": "@apmixbot/dsh-mcp-resources",
  "description": "Scoped MCP resource discovery and reading through shared model tools",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-llm": "0.2.1-rc.2",
    "@apmixbot/dsh-scope": "0.2.1-rc.2",
    "@apmixbot/dsh-system-prompt": "0.2.1-rc.2",
    "@apmixbot/dsh-tools": "0.2.1-rc.2"
  },
  "dependencies": {
    "@apmixbot/dsh-util-values": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@apmixbot/dsh-system-prompt": {
      "optional": true
    }
  }
}

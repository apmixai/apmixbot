{
  "name": "@apmixbot/dsh-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the ApmixBot filesystem seam (ctx.fs)",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@apmixbot/schemastery": "3.18.5",
    "@apmixbot/dsh-util-code-language": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@apmixbot/dsh-attachment": "0.2.1-rc.2",
    "@apmixbot/dsh-fs": "0.2.1-rc.2",
    "@apmixbot/dsh-llm": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox-policy": "0.2.1-rc.2",
    "@apmixbot/dsh-session": "0.2.1-rc.2",
    "@apmixbot/dsh-system-prompt": "0.2.1-rc.2",
    "@apmixbot/dsh-tools": "0.2.1-rc.2",
    "@apmixbot/dsh-user-approval": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-working-directory": "0.2.1-rc.2"
  }
}

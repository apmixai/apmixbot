{
  "name": "@apmixbot/dsh-plan-mode",
  "description": "Logged per-agent plan mode with deployment guidance, a direct slash command, and a user-reviewed exit",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/dsh-agent": "0.2.1-rc.2",
    "@apmixbot/dsh-commands": "0.2.1-rc.2",
    "@apmixbot/dsh-llm": "0.2.1-rc.2",
    "@apmixbot/dsh-session": "0.2.1-rc.2",
    "@apmixbot/dsh-session-projection": "0.2.1-rc.2",
    "@apmixbot/dsh-system-prompt": "0.2.1-rc.2",
    "@apmixbot/dsh-tools": "0.2.1-rc.2",
    "@apmixbot/dsh-user-questions": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5"
  },
  "peerDependenciesMeta": {
    "@apmixbot/dsh-commands": {
      "optional": true
    }
  },
  "dependencies": {
    "@apmixbot/dsh-brand": "0.2.1-rc.2",
    "zod": "4.4.3"
  }
}

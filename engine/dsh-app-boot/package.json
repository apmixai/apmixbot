{
  "name": "@apmixbot/dsh-app-boot",
  "description": "Shared boot glue for the app bins: .env loading, fail-loud Loader guards, snapshot-aware config resolution, and the Loader boot sequence",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker/profile-resolution-bootstrap": {
      "types": "./lib/types/profile-resolution/worker-bootstrap.d.ts",
      "default": "./lib/worker/profile-resolution-bootstrap.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker/profile-resolution-bootstrap.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@apmixbot/dsh-atomic-write": "0.2.1-rc.2",
    "@apmixbot/dsh-package-manifest": "0.2.1-rc.2",
    "@eslint-community/regexpp": "^4.12.2",
    "ajv": "^8.20.0",
    "js-yaml": "^4.3.2",
    "node-addon-require-builtin": "^0.1.9",
    "resolve.exports": "^2.0.3",
    "semver": "^7.8.5"
  },
  "peerDependencies": {
    "@apmixbot/cordis-plugin-group": "1.0.5",
    "@apmixbot/cordis-plugin-include": "1.0.10",
    "@apmixbot/cordis-plugin-loader": "1.0.6",
    "@apmixbot/dsh-launch-environment": "0.2.1-rc.2",
    "@apmixbot/dsh-home-paths": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5"
  }
}

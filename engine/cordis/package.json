{
  "name": "@apmixbot/cordis",
  "description": "Meta-Framework for Modern JavaScript Applications",
  "version": "4.0.5",
  "sideEffects": false,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "bin.js",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis-plugin-include": "1.0.10",
    "@apmixbot/cordis-plugin-loader": "1.0.6"
  },
  "peerDependenciesMeta": {
    "@apmixbot/cordis-plugin-include": {
      "optional": true
    },
    "@apmixbot/cordis-plugin-loader": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@apmixbot/cosmokit": "1.8.6"
  },
  "bin": {
    "cordis": "bin.js"
  }
}

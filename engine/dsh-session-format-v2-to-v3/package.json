{
  "name": "@apmixbot/dsh-session-format-v2-to-v3",
  "description": "Streaming system-prompt, canonical-envelope and PTC migration into V3",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "from": 2,
      "to": 3,
      "export": ".",
      "migration": "sessionFormatV2ToV3",
      "sourceCodec": "releasedV2SessionFormatCodec",
      "targetCodec": "releasedV3SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV3Header",
      "targetRestorer": "restoreReleasedV3Artifact"
    }
  },
  "dependencies": {
    "@apmixbot/dsh-session-format": "0.2.1-rc.2",
    "@apmixbot/dsh-session-format-v0-to-v1": "0.2.1-rc.2",
    "@apmixbot/dsh-session-format-v1-to-v2": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5"
  }
}

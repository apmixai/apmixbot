{
  "name": "@apmixbot/dsh-hmr",
  "description": "Coordinated module and profile configuration hot reload",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/cordis-plugin-timer": "1.1.7",
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/cordis-plugin-loader": "1.0.6",
    "@apmixbot/cordis-plugin-include": "1.0.10",
    "@apmixbot/dsh-app-boot": "0.2.1-rc.2",
    "@apmixbot/dsh-cmdline": "0.2.1-rc.2"
  },
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "chokidar": "5.0.0",
    "node-addon-require-builtin": "^0.1.9",
    "picomatch": "^4.0.7",
    "@apmixbot/schemastery": "3.18.5"
  }
}

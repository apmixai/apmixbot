{
  "name": "@apmixbot/dsh-session-format-v1-to-v2",
  "description": "Frozen released-v1 Session codec and assistant-stream migration to v2",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "from": 1,
      "to": 2,
      "export": ".",
      "migration": "sessionFormatV1ToV2",
      "sourceCodec": "releasedV1SessionFormatCodec",
      "targetCodec": "releasedV2SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV2Header",
      "targetRestorer": "restoreReleasedV2Artifact"
    }
  },
  "dependencies": {
    "@apmixbot/dsh-llm": "0.2.1-rc.2",
    "@apmixbot/dsh-session-format": "0.2.1-rc.2",
    "@apmixbot/dsh-session-format-v0-to-v1": "0.2.1-rc.2",
    "@apmixbot/dsh-util-values": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@apmixbot/cordis": "4.0.5"
  }
}

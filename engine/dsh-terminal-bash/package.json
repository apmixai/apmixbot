{
  "name": "@apmixbot/dsh-terminal-bash",
  "description": "Persistent shell PTY backend over the ApmixBot subprocess terminal primitive",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/dsh-agent": "0.2.1-rc.2",
    "@apmixbot/dsh-terminal": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox": "0.2.1-rc.2",
    "@apmixbot/dsh-sandbox-policy": "0.2.1-rc.2",
    "@apmixbot/dsh-session": "0.2.1-rc.2",
    "@apmixbot/dsh-subprocess": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-session-projection": "0.2.1-rc.2",
    "@apmixbot/dsh-working-directory": "0.2.1-rc.2"
  },
  "dependencies": {
    "@apmixbot/dsh-lazy-require": "0.2.1-rc.2",
    "@apmixbot/dsh-pwsh-local": "0.2.1-rc.2",
    "@apmixbot/schemastery": "3.18.5",
    "@xterm/headless": "^6.0.0"
  }
}

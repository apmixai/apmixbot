{
  "name": "@apmixbot/dsh-agent-loop",
  "description": "The concrete agent loop plugin for the ApmixBot",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",

{
  "name": "@apmixbot/dsh-mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/dsh-attachment": "0.2.1-rc.2",
    "@apmixbot/dsh-llm": "0.2.1-rc.2",
    "@apmixbot/dsh-scope": "0.2.1-rc.2",
    "@apmixbot/dsh-subprocess": "0.2.1-rc.2",
    "@apmixbot/dsh-timeout": "0.2.1-rc.2",
    "@apmixbot/dsh-tools": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5",
    "@apmixbot/dsh-mcp-resources": "0.2.1-rc.2",
    "@apmixbot/dsh-system-prompt": "0.2.1-rc.2"
  },
  "dependencies": {
    "@apmixbot/schemastery": "3.18.5",
    "@modelcontextprotocol/client": "2.2.0",
    "@apmixbot/dsh-util-values": "0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@apmixbot/dsh-mcp-resources": {
      "optional": true
    },
    "@apmixbot/dsh-system-prompt": {
      "optional": true
    }
  }
}

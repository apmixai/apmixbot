{
  "name": "@apmixbot/dsh-fs-local",
  "description": "Local-filesystem implementation of the ApmixBot filesystem seam (ctx.fs)",
  "version": "0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@apmixbot/dsh-fs": "0.2.1-rc.2",
    "@apmixbot/cordis": "4.0.5"
  },
  "dependencies": {
    "chokidar": "5.0.0",
    "koffi": "3.1.1",
    "@apmixbot/schemastery": "3.18.5"
  }
}
